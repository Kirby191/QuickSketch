front-end/playwright/.auth/

# ==========================================
# REGOLE BACK-END (Express & SQLite)
# ==========================================
# File di ambiente
back-end/.env

# Database locale SQLite
back-end/*.sqlite
back-end/*.db

# File temporanei journal/WAL di SQLite
back-end/*.db-journal
back-end/*.db-wal
back-end/*.db-shm
back-end/*.sqlite-journal