# ==========================================
# CONFIGURAZIONE SERVER EXPRESS
# ==========================================
PORT=3000
FRONTEND_URL="http://localhost:4200"

# ==========================================
# CONFIGURAZIONE DATABASE (Sequelize)
# ==========================================
DB_CONNECTION_URI="sqlite:database.db"

# ==========================================
# SICUREZZA E AUTENTICAZIONE (JWT)
# ==========================================
JWT_SECRET="INSERISCI_QUI_UNA_CHIAVE_SEGRETA_CASUALE"
JWT_EXPIRATION="24h"

# ==========================================
# CONFIGURAZIONE ADMIN (per creare un utente admin iniziale)
# ==========================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"